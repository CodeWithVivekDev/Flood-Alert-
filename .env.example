# Baadh Bol Environment Variables (Example)
# Copy to .env for local testing. NEVER commit real credentials or phone numbers.

# AWS Configuration
AWS_REGION=ap-south-1
ENVIRONMENT=local

# DynamoDB Table Names (SAM will provide these in production)
AREAS_TABLE=BaadhBol-Areas-local
RESIDENTS_TABLE=BaadhBol-Residents-local
ALERTS_TABLE=BaadhBol-Alerts-local
CALLS_TABLE=BaadhBol-Calls-local

# S3 Audio Storage
AUDIO_BUCKET_NAME=baadh-bol-audio-cache-local

# SQS Queue URL
ALERT_QUEUE_URL=

# Calling Provider: 'mock' | 'twilio' | 'connect'
CALL_PROVIDER=mock

# Twilio Settings (if using Twilio provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# Amazon Connect Settings (if using Connect provider)
CONNECT_INSTANCE_ID=
CONNECT_CONTACT_FLOW_ID=
CONNECT_SOURCE_PHONE_NUMBER=

# Bedrock Model ID
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Polly Configuration
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=neural

# Safety / Allowlist Configuration
# In test mode, only phone numbers in this comma-separated list will receive calls
TEST_ALLOWLIST_PHONES=+919876543210,+919999999999
AUTO_CALL_ENABLED=false
MAX_CALL_ATTEMPTS=2

# National Hydrological & Disaster Early-Warning Integrations
CWC_API_URL=https://ffs.india-water.gov.in/api/v1/water-levels
CWC_API_TOKEN=
NDMA_SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_feed/
NDMA_SACHET_AUTH_COOKIE=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-south-1
